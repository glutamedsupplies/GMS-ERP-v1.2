{
  "name": "attendanceapp",
  "version": "1.0.0",
  "description": "GMS ERP for head admin and employees",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,sqlite3",
    "start": "node server.js",
    "server": "node server.js",
    "server:node": "node server.js",
    "migrate:multi-tenant": "node migrations/run-migrations.js",
    "migrate:legacy": "node migrations/legacy-import.js",
    "test:multi-tenant": "node tests/multi-tenant-integration.js",
    "desktop": "electron .",
    "dist:server": "electron-builder --win nsis --config.productName=\"Attendance Server\" --config.directories.output=dist/server",
    "dist:client": "electron-builder --win nsis --config.extraMetadata.main=main-client.js --config.productName=\"Attendance Client\" --config.directories.output=dist/client",
    "dist:all": "npm run dist:server && npm run dist:client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.attendanceapp.lan",
    "asar": true,
    "files": [
      "assets/**/*",
      "employee/**/*",
      "head_admin/**/*",
      "super_admin/**/*",
      "lib/**/*",
      "migrations/**/*",
      "renderer/**/*",
      "shared/**/*",
      "index.html",
      "client-config.json",
      "logo.png",
      "Signature_JHV.png",
      "main.js",
      "main-client.js",
      "manifest.webmanifest",
      "package.json",
      "preload.js",
      "renderer.js",
      "server.js",
      "service-worker.js",
      "!dist/**/*",
      "!head_admin/data/*.db",
      "!head_admin/data/*.db-wal",
      "!head_admin/data/*.db-shm",
      "!employee/data/*.db",
      "!employee/data/*.db-wal",
      "!employee/data/*.db-shm"
    ],
    "extraResources": [
      {
        "from": "head_admin/data",
        "to": "seed-data/head_admin/data",
        "filter": [
          "*.db",
          "*.db-wal",
          "*.db-shm"
        ]
      },
      {
        "from": "employee/data",
        "to": "seed-data/employee/data",
        "filter": [
          "*.db",
          "*.db-wal",
          "*.db-shm"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^6.25.0",
    "pg": "^8.20.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  },
  "directories": {
    "lib": "lib"
  }
}
